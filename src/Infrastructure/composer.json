{
    "name": "sokol/infrastructure",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sokol/application": "^1.0",
        "sokol/domain": "^1.0",
        "illuminate/auth": "^12.0",
        "illuminate/cache": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/hashing": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/log": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sokol\\Infrastructure\\": ""
        },
        "exclude-from-classmap": [
            "Database/Migrations/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sokol\\Infrastructure\\InfrastructureServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
